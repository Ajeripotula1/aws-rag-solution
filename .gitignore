# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets and local config (keep .env.example committed)
.env
.env.*
!.env.example

# Test, lint, and coverage caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# CDK (Day 2+)
cdk.out/
.cdk.staging/
cdk.context.json
node_modules/

# Local AWS artifacts and build bundles
.aws-sam/
samconfig.toml
*.zip

# Keys, certificates, and credential files
*.pem
*.key
*.p12
*.pfx
.aws/
credentials.json
secrets.json

# AgentCore CLI local files (each project's agentcore/.gitignore also covers these)
.env.local
**/agentcore/.cli/traces/
**/agentcore/.cli/logs/
**/agentcore/.cli/migrate/

# Claude Code per-user settings (shared .claude/settings.json stays committed)
.claude/settings.local.json

# Type-checker caches
.mypy_cache/

# Editors and OS
.vscode/
.idea/
.DS_Store

# Scratch files
*.log
tmp/